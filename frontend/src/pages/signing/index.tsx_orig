import { useEffect } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import {
  ActionIcon,
  Badge,
  Box,
  Button,
  Card,
  Container,
  Group,
  Loader,
  Menu,
  Paper,
  Stack,
  Table,
  Text,
  Title,
  Tooltip,
} from "@mantine/core";
import { useMediaQuery } from "@mantine/hooks";
import {
  TbBell,
  TbDotsVertical,
  TbDownload,
  TbFileDescription,
  TbInbox,
  TbPlus,
  TbShieldCheck,
  TbX,
  TbFileOff,
} from "react-icons/tb";
import { useRouter } from "next/router";
import Meta from "../../components/Meta";
import signingService, { SignatureRequest } from "../../services/signing.service";
import toast from "../../utils/toast.util";
import useUser from "../../hooks/user.hook";

const statusColors: Record<string, string> = {
  PENDING: "yellow",
  PARTIAL: "blue",
  COMPLETED: "green",
  CANCELLED: "gray",
  REJECTED: "red",
  AWAITING_FINALIZATION: "orange",
};

const statusLabels: Record<string, string> = {
  PENDING: "En attente",
  PARTIAL: "En cours",
  COMPLETED: "Complété",
  CANCELLED: "Annulé",
  REJECTED: "Refusé",
  AWAITING_FINALIZATION: "Finalisation E2E",
};

const SigningIndexPage = () => {
  const router = useRouter();
  const queryClient = useQueryClient();
  const { user } = useUser();
  const isMobile = useMediaQuery("(max-width: 680px)");

  // Redirect to login if not authenticated, or to pricing if plan is insufficient
  useEffect(() => {
    if (user === null) {
      router.replace("/auth/signIn?redirect=/signing");
    } else if (user && user.plan !== "TEAM" && !user.isAdmin && !user.hasTeamMembership) {
      router.replace("/pricing");
    }
  }, [user]);

  const { data: documents, isLoading } = useQuery({
    queryKey: ["signing.documents"],
    queryFn: () => signingService.getMyDocuments(),
    enabled: !!user,
  });

  const { data: receivedDocs, isLoading: isLoadingReceived } = useQuery({
    queryKey: ["signing.received"],
    queryFn: () => signingService.getReceivedDocuments(),
    enabled: !!user,
  });

  const cancelMutation = useMutation({
    mutationFn: (id: string) => signingService.cancelDocument(id),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["signing.documents"] });
      toast.success("Demande de signature annulée");
    },
    onError: () => toast.error("Impossible d'annuler"),
  });

  const reminderMutation = useMutation({
    mutationFn: (id: string) => signingService.sendReminder(id),
    onSuccess: () => toast.success("Rappel envoyé"),
    onError: () => toast.error("Impossible d'envoyer le rappel"),
  });

  const handleDownload = async (doc: SignatureRequest) => {
    // For E2E encrypted documents, redirect to detail page which handles decryption
    if (doc.isE2EEncrypted) {
      router.push(`/signing/${doc.id}`);
      return;
    }
    try {
      const blob = await signingService.downloadSigned(doc.id);
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${doc.title || doc.fileName || "document"}_signe.pdf`;
      a.click();
      URL.revokeObjectURL(url);
    } catch {
      toast.error("Impossible de télécharger le document signé");
    }
  };

  if (!user) {
    return (
      <Box ta="center" py="xl">
        <Loader />
      </Box>
    );
  }

  return (
    <>
      <Meta title="Signatures électroniques" />
      <Container size="lg" mt="xl">
        <Group justify="space-between" mb="lg">
          <Title order={2}>
            <Group gap="xs">
              <TbFileDescription size={28} />
              Mes signatures
            </Group>
          </Title>
          <Button
            leftSection={<TbPlus size={16} />}
            onClick={() => router.push("/signing/new")}
          >
            Nouvelle demande
          </Button>
        </Group>

        {isLoading && (
          <Box ta="center" py="xl">
            <Loader />
          </Box>
        )}

        {!isLoading && (!documents || documents.length === 0) && (
          <Paper withBorder p="xl" ta="center">
            <Stack align="center" gap="md">
              <TbShieldCheck size={48} color="gray" />
              <Text c="dimmed">
                Aucune demande de signature. Créez votre première demande pour
                faire signer vos documents PDF conformément au règlement eIDAS.
              </Text>
              <Button
                leftSection={<TbPlus size={16} />}
                onClick={() => router.push("/signing/new")}
              >
                Créer une demande de signature
              </Button>
            </Stack>
          </Paper>
        )}

        {documents && documents.length > 0 && (
          isMobile ? (
            <Stack gap="sm">
              {documents.map((doc) => (
                <Card key={doc.id} withBorder padding="sm" style={{ cursor: "pointer" }} onClick={() => router.push(`/signing/${doc.id}`)}>
                  <Group justify="space-between" mb={4}>
                    <Text fw={600} size="sm" lineClamp={1} style={{ flex: 1 }}>
                      {doc.fileName || doc.title || "Sans titre"}
                    </Text>
                    <Badge color={statusColors[doc.status] || "gray"} variant="light" size="sm">
                      {statusLabels[doc.status] || doc.status}
                    </Badge>
                  </Group>
                  <Group gap={4} mb={4}>
                    <Badge color="blue" variant="light" size="xs">{doc.signatureLevel}</Badge>
                    {(doc as any).fileDeleted && (
                      <Tooltip label="Le fichier source a été supprimé">
                        <Badge color="red" variant="light" size="xs" leftSection={<TbFileOff size={10} />}>
                          Supprimé
                        </Badge>
                      </Tooltip>
                    )}
                    <Text size="xs" c="dimmed">
                      {new Date(doc.createdAt).toLocaleDateString("fr-FR", { timeZone: "Europe/Paris" })}
                    </Text>
                  </Group>
                  <Stack gap={2}>
                    {doc.recipients?.map((r) => (
                      <Tooltip key={r.id} label={`${r.name} — ${r.email}`} multiline maw={250}>
                        <Badge
                          size="xs"
                          color={r.status === "SIGNED" ? "green" : r.status === "REJECTED" ? "red" : "gray"}
                          variant="dot"
                          style={{ maxWidth: "100%" }}
                        >
                          <Text size="xs" truncate style={{ maxWidth: 140 }}>{r.name}</Text>
                        </Badge>
                      </Tooltip>
                    ))}
                  </Stack>
                  <Group gap={4} mt="xs" onClick={(e) => e.stopPropagation()}>
                    {doc.status === "COMPLETED" && !(doc as any).fileDeleted && (
                      <Button size="compact-xs" variant="light" color="green" onClick={() => handleDownload(doc)}>
                        Télécharger
                      </Button>
                    )}
                    {(doc.status === "PENDING" || doc.status === "PARTIAL") && (
                      <Button size="compact-xs" variant="light" onClick={() => reminderMutation.mutate(doc.id)}>
                        Rappel
                      </Button>
                    )}
                  </Group>
                </Card>
              ))}
            </Stack>
          ) : (
          <Paper withBorder>
            <Table striped highlightOnHover style={{ tableLayout: "fixed" }}>
              <Table.Thead>
                <Table.Tr>
                  <Table.Th>Document</Table.Th>
                  <Table.Th style={{ width: 80 }}>Niveau</Table.Th>
                  <Table.Th style={{ width: 180 }}>Signataires</Table.Th>
                  <Table.Th style={{ width: 165 }}>Statut</Table.Th>
                  <Table.Th style={{ width: 100 }}>Date</Table.Th>
                  <Table.Th style={{ width: 80 }}>Actions</Table.Th>
                </Table.Tr>
              </Table.Thead>
              <Table.Tbody>
                {documents.map((doc) => (
                  <Table.Tr
                    key={doc.id}
                    style={{ cursor: "pointer" }}
                    onClick={() => router.push(`/signing/${doc.id}`)}
                  >
                    <Table.Td style={{ overflow: "hidden" }}>
                      <Group gap={6} wrap="nowrap">
                        <Text fw={500} truncate style={{ flex: 1 }}>
                          {doc.fileName || doc.title || "Sans titre"}
                        </Text>
                        {(doc as any).fileDeleted && (
                          <Tooltip label="Le fichier source a été supprimé">
                            <Badge color="red" variant="light" size="xs" leftSection={<TbFileOff size={10} />}>
                              Supprimé
                            </Badge>
                          </Tooltip>
                        )}
                      </Group>
                    </Table.Td>
                    <Table.Td>
                      <Badge
                        color={
                          doc.signatureLevel === "QES" ? "violet" : "blue"
                        }
                        variant="light"
                        size="sm"
                      >
                        {doc.signatureLevel}
                      </Badge>
                    </Table.Td>
                    <Table.Td>
                      <Stack gap={2}>
                        {doc.recipients?.map((r) => (
                          <Tooltip key={r.id} label={`${r.name} — ${r.email}`} multiline maw={300}>
                            <Badge
                              size="sm"
                              color={
                                r.status === "SIGNED"
                                  ? "green"
                                  : r.status === "REJECTED"
                                    ? "red"
                                    : "gray"
                              }
                              variant="dot"
                              style={{ maxWidth: "100%" }}
                            >
                              <Text size="xs" truncate style={{ maxWidth: 150 }}>{r.name}</Text>
                            </Badge>
                          </Tooltip>
                        ))}
                      </Stack>
                    </Table.Td>
                    <Table.Td>
                      <Badge
                        color={statusColors[doc.status] || "gray"}
                        variant="light"
                      >
                        {statusLabels[doc.status] || doc.status}
                      </Badge>
                    </Table.Td>
                    <Table.Td>
                      <Text size="sm" c="dimmed">
                        {new Date(doc.createdAt).toLocaleDateString("fr-FR", { timeZone: "Europe/Paris" })}
                      </Text>
                    </Table.Td>
                    <Table.Td>
                      <Group gap={4} wrap="nowrap" onClick={(e) => e.stopPropagation()}>
                        <Tooltip label="Voir les détails">
                          <ActionIcon
                            variant="light"
                            color="blue"
                            size="sm"
                            onClick={() => router.push(`/signing/${doc.id}`)}
                          >
                            <TbFileDescription size={14} />
                          </ActionIcon>
                        </Tooltip>
                        {doc.status === "AWAITING_FINALIZATION" && (
                          <Tooltip label="Finaliser le chiffrement E2E">
                            <ActionIcon
                              variant="filled"
                              color="orange"
                              size="sm"
                              onClick={() => router.push(`/signing/${doc.id}`)}
                            >
                              <TbShieldCheck size={14} />
                            </ActionIcon>
                          </Tooltip>
                        )}
                        <Menu position="bottom-end">
                          <Menu.Target>
                            <ActionIcon variant="subtle" color="gray">
                              <TbDotsVertical size={16} />
                            </ActionIcon>
                          </Menu.Target>
                        <Menu.Dropdown>
                          {doc.status === "COMPLETED" && !(doc as any).fileDeleted && (
                            <Menu.Item
                              leftSection={<TbDownload size={14} />}
                              onClick={() => handleDownload(doc)}
                            >
                              Télécharger le PDF signé
                            </Menu.Item>
                          )}
                          {(doc.status === "PENDING" ||
                            doc.status === "PARTIAL") && (
                            <>
                              <Menu.Item
                                leftSection={<TbBell size={14} />}
                                onClick={() => reminderMutation.mutate(doc.id)}
                              >
                                Envoyer un rappel
                              </Menu.Item>
                              <Menu.Item
                                leftSection={<TbX size={14} />}
                                color="red"
                                onClick={() => cancelMutation.mutate(doc.id)}
                              >
                                Annuler
                              </Menu.Item>
                            </>
                          )}
                          <Menu.Item
                            leftSection={<TbFileDescription size={14} />}
                            onClick={() =>
                              router.push(`/signing/${doc.id}`)
                            }
                          >
                            Détails & piste d'audit
                          </Menu.Item>
                        </Menu.Dropdown>
                      </Menu>
                      </Group>
                    </Table.Td>
                  </Table.Tr>
                ))}
              </Table.Tbody>
            </Table>
          </Paper>
          )
        )}

        {/* ============= Documents reçus (signé par moi) ============= */}
        <Title order={3} mt="xl" mb="md">
          <Group gap="xs">
            <TbInbox size={24} />
            Documents reçus
          </Group>
        </Title>

        {isLoadingReceived && (
          <Box ta="center" py="xl">
            <Loader />
          </Box>
        )}

        {!isLoadingReceived && (!receivedDocs || receivedDocs.length === 0) && (
          <Paper withBorder p="lg" ta="center">
            <Text c="dimmed" size="sm">
              Aucun document reçu pour signature.
            </Text>
          </Paper>
        )}

        {receivedDocs && receivedDocs.length > 0 && (
          isMobile ? (
            <Stack gap="sm">
              {receivedDocs.map((doc) => {
                const creator = (doc as any).creator;
                const myRecipient = doc.recipients?.find(
                  (r) => r.status === "SIGNED" || r.status === "PENDING" || r.status === "VIEWED"
                );
                return (
                  <Card key={doc.id} withBorder padding="sm" style={{ cursor: "pointer" }} onClick={() => router.push(`/signing/${doc.id}`)}>
                    <Group justify="space-between" mb={4}>
                      <Text fw={600} size="sm" lineClamp={1} style={{ flex: 1 }}>
                        {doc.fileName || doc.title || "Sans titre"}
                      </Text>
                      <Badge color={statusColors[doc.status] || "gray"} variant="light" size="sm">
                        {statusLabels[doc.status] || doc.status}
                      </Badge>
                    </Group>
                    <Group gap="xs" mb={4}>
                      <Text size="xs" c="dimmed">De : {creator?.username || creator?.email || "—"}</Text>
                      <Badge size="xs" variant="light" color="blue">
                        {myRecipient?.role === "SIGNER" ? "Signataire" : myRecipient?.role === "APPROVER" ? "Approbateur" : myRecipient?.role === "CC" ? "Copie" : "—"}
                      </Badge>
                    </Group>
                    <Text size="xs" c="dimmed">
                      {new Date(doc.createdAt).toLocaleDateString("fr-FR", { timeZone: "Europe/Paris" })}
                    </Text>
                    {doc.status === "COMPLETED" && (
                      <Group mt="xs" onClick={(e) => e.stopPropagation()}>
                        <Button size="compact-xs" variant="light" color="green" onClick={() => handleDownload(doc)}>
                          Télécharger
                        </Button>
                      </Group>
                    )}
                  </Card>
                );
              })}
            </Stack>
          ) : (
          <Paper withBorder>
            <Table striped highlightOnHover style={{ tableLayout: "fixed" }}>
              <Table.Thead>
                <Table.Tr>
                  <Table.Th>Document</Table.Th>
                  <Table.Th style={{ width: 140 }}>Envoyé par</Table.Th>
                  <Table.Th style={{ width: 100 }}>Mon rôle</Table.Th>
                  <Table.Th style={{ width: 165 }}>Statut</Table.Th>
                  <Table.Th style={{ width: 100 }}>Date</Table.Th>
                  <Table.Th style={{ width: 80 }}>Actions</Table.Th>
                </Table.Tr>
              </Table.Thead>
              <Table.Tbody>
                {receivedDocs.map((doc) => {
                  const creator = (doc as any).creator;
                  const myRecipient = doc.recipients?.find(
                    (r) => r.status === "SIGNED" || r.status === "PENDING" || r.status === "VIEWED"
                  );
                  return (
                    <Table.Tr
                      key={doc.id}
                      style={{ cursor: "pointer" }}
                      onClick={() => router.push(`/signing/${doc.id}`)}
                    >
                      <Table.Td style={{ overflow: "hidden" }}>
                        <Text fw={500} truncate>
                          {doc.fileName || doc.title || "Sans titre"}
                        </Text>
                      </Table.Td>
                      <Table.Td>
                        <Text size="sm">
                          {creator?.username || creator?.email || "—"}
                        </Text>
                      </Table.Td>
                      <Table.Td>
                        <Badge size="xs" variant="light" color="blue">
                          {myRecipient?.role === "SIGNER"
                            ? "Signataire"
                            : myRecipient?.role === "APPROVER"
                              ? "Approbateur"
                              : myRecipient?.role === "CC"
                                ? "Copie"
                                : "—"}
                        </Badge>
                      </Table.Td>
                      <Table.Td>
                        <Badge
                          color={statusColors[doc.status] || "gray"}
                          variant="light"
                        >
                          {statusLabels[doc.status] || doc.status}
                        </Badge>
                      </Table.Td>
                      <Table.Td>
                        <Text size="sm" c="dimmed">
                          {new Date(doc.createdAt).toLocaleDateString("fr-FR", { timeZone: "Europe/Paris" })}
                        </Text>
                      </Table.Td>
                      <Table.Td>
                        <Group gap={4} wrap="nowrap" onClick={(e) => e.stopPropagation()}>
                          <Tooltip label="Voir le document">
                            <ActionIcon
                              variant="light"
                              color="blue"
                              size="sm"
                              onClick={() => router.push(`/signing/${doc.id}`)}
                            >
                              <TbFileDescription size={14} />
                            </ActionIcon>
                          </Tooltip>
                          {doc.status === "COMPLETED" && (
                            <Tooltip label="Télécharger le PDF signé">
                              <ActionIcon
                                variant="light"
                                color="green"
                                size="sm"
                                onClick={() => handleDownload(doc)}
                              >
                                <TbDownload size={14} />
                              </ActionIcon>
                            </Tooltip>
                          )}
                        </Group>
                      </Table.Td>
                    </Table.Tr>
                  );
                })}
              </Table.Tbody>
            </Table>
          </Paper>
          )
        )}
      </Container>
    </>
  );
};

export default SigningIndexPage;
