{
  "name": "privcloud-sharing-frontend",
  "version": "1.26.3",
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev --webpack",
    "prebuild": "node ../scripts/build-public-verification.mjs && node scripts/copy-pdf-worker.mjs && node scripts/build-photo-registration.mjs && node scripts/build-image-decoders.mjs && node scripts/build-video-decoders.mjs && sh scripts/strip-legacy-polyfills.sh",
    "build": "next build --webpack",
    "postbuild": "node scripts/check-mlkem-bundle.mjs && node scripts/check-altcha-csp.mjs",
    "start": "next start",
    "lint": "eslint src/",
    "format": "prettier --end-of-line=auto --write \"src/**/*.ts*\"",
    "test:companion-browser": "node test/bridge-local-network-browser-smoke.cjs",
    "test:companion-browser:real": "node test/bridge-local-network-browser-smoke.cjs --real-companion",
    "test:security": "node --test test/dependency-security.test.mjs test/brace-patterns-security.test.mjs",
    "test:preview-browser": "node test/preview-browser-smoke.cjs",
    "test:video-preview-browser": "node --no-warnings --experimental-transform-types --import ./test/register-ts.mjs test/video-preview-browser-smoke.cjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.13.3",
    "@emotion/serialize": "^1.3.3",
    "@emotion/server": "^11.11.0",
    "@emotion/utils": "^1.4.2",
    "@mantine/core": "8.3.18",
    "@mantine/dropzone": "8.3.18",
    "@mantine/emotion": "8.3.18",
    "@mantine/form": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/modals": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@noble/post-quantum": "^0.7.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.83.0",
    "altcha": "^3.1.0",
    "axios": "1.20.0",
    "clsx": "^2.1.1",
    "cookies-next": "^4.2.1",
    "dayjs": "^1.11.20",
    "fflate": "^0.8.2",
    "get-nonce": "1.0.1",
    "global-agent": "4.1.3",
    "isomorphic-dompurify": "^3.12.0",
    "jwt-decode": "^4.0.0",
    "mantine-form-yup-resolver": "^2.0.0",
    "markdown-to-jsx": "^7.5.0",
    "mime-types": "^2.1.35",
    "next": "16.4.1",
    "next-http-proxy-middleware": "^1.2.6",
    "p-limit": "^6.1.0",
