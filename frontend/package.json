    "pdfjs-dist": "4.10.38",
    "postcss": "8.5.25",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-intl": "^6.6.8",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "yup": "^1.4.0",
    "@yume-chan/libde265": "1.0.0",
    "libheif-js": "1.23.5",
    "lowlight": "3.3.0",
    "utif2": "4.1.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "@techstark/opencv-js": "5.0.0-release.1",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.1",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^25.8.0",
    "@types/react": "18.3.7",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/parser": "^8.60.0",
    "axios": "1.20.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.25",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "braces": "file:./vendor/brace-patterns"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "postcss": "8.5.25",
    "serialize-javascript": "^7.0.3",
    "tar": "^7.5.10",
    "diff": "^8.0.3",
    "js-yaml": "5.4.2",
    "minimatch@^10.0.0": {
      "brace-expansion": "5.0.12"
    },
    "picomatch": ">=4.0.4",
    "axios": "1.20.0",
    "next": "16.4.1",
    "sharp": "$sharp",
    "nanoid": "5.1.16",
    "dompurify": "3.4.17",
    "follow-redirects": "1.16.2",
    "undici": "7.30.1",
    "braces": "$braces"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "allowScripts": {
    "unrs-resolver@1.11.1": true,
    "sharp@0.35.5": true
  }
