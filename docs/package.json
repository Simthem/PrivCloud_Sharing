    "sirv": ">=3.0.2",
    "lodash": ">=4.18.1",
    "uuid": ">=14.0.0",
    "fast-uri": "3.1.5",
    "postcss": ">=8.5.23",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
    "http-proxy-middleware": "^3.0.6",
    "webpack": "5.105.0",
    "webpack-dev-server": ">=5.2.6",
    "qs": ">=6.15.2",
    "body-parser": ">=1.20.6",
    "shell-quote": "^1.10.0",
    "websocket-driver": ">=0.7.5",
    "brace-expansion": "5.0.9",
    "js-yaml": "5.2.2",
    "undici": "7.29.0",
    "nanoid": "5.1.16"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "core-js-pure@3.49.0": true
