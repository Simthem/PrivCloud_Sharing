{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Keep the Docusaurus editor/typecheck defaults locally because its published
  // preset still declares baseUrl, which is unsupported by TypeScript 7.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "include": ["**/*.js", "**/*.mjs", "**/*.ts", "**/*.tsx"],
  "exclude": ["build", "node_modules"]
}
