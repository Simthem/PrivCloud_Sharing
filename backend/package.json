{
  "name": "privcloud-sharing-backend",
  "version": "1.24.0",
  "scripts": {
    "build": "nest build",
    "postinstall": "[ -f prisma/schema.prisma ] && prisma generate || true",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "db:prepare": "node scripts/ensure-sqlite-database.mjs",
    "prod": "npm run db:prepare && prisma migrate deploy && prisma db seed && node dist/src/main",
    "lint": "eslint src/",
    "format": "prettier --end-of-line=auto --write 'src/**/*.ts'",
    "test": "npm run test:unit",
    "test:unit": "NODE_PATH=. node -r ts-node/register test/unit-runner.ts",
    "test:system": "node test/run-system-tests.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
