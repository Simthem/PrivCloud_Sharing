generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username String  @unique
  email    String  @unique
  password String?
  isAdmin  Boolean @default(false)
  ldapDN   String? @unique

  // Download notification preference: INSTANT | DIGEST | WEEKLY
  notificationMode String @default("DIGEST")

  shares        Share[]
  refreshTokens RefreshToken[]
  loginTokens   LoginToken[]
  reverseShares ReverseShare[]

  totpEnabled        Boolean             @default(false)
  totpVerified       Boolean             @default(false)
  totpSecret         String?
  totpBackupCodes    TotpBackupCode[]
  resetPasswordToken ResetPasswordToken?

  // NULL requiredAt is the permanent legacy exemption. Migrations must never
  // backfill it: only accounts created after the feature deployment opt in.
  emailVerificationRequiredAt        DateTime?
  emailVerifiedAt                    DateTime?
  emailVerificationDeletionStartedAt DateTime?
  emailVerificationTokens            EmailVerificationToken[]

  // E2E encryption: SHA-256 hex hash of the user's AES-256 key (never the key itself)
  encryptionKeyHash           String?
  e2eAutoGenerationDisabledAt DateTime?

  oAuthUsers         OAuthUser[]
  pushSubscriptions  PushSubscription[]
  bridgeUploadTokens BridgeUploadToken[]

  // Passkey-wrapped E2E keys for multi-device sync
  wrappedKeys WrappedKey[]

  // PDF Signing: documents created by this user
  signatureDocuments        SignatureDocument[]
  // PDF Signing: signing actions performed by this user
  signatureRecipients       SignatureRecipient[]
  // WebAuthn credentials dedicated to transaction-bound signatures
  signingPasskeys           SigningPasskey[]
  // Short-lived WebAuthn ceremonies for registration and signing
  signingWebAuthnChallenges SigningWebAuthnChallenge[]

  // Teams: memberships
  teamMemberships TeamMember[]
  // Teams: owned teams
  ownedTeams      Team[]

  // E2EE Identity layer (X25519 + Ed25519 key pairs)
  identityKeys      UserIdentityKey[]
  // E2EE Access grants received (encrypted DEKs)
  accessGrants      AccessGrant[]
  // E2EE Post-quantum keys (ML-KEM)
  pqKeys            UserPQKey[]
  // Team notifications
  teamNotifications TeamNotification[]

  // Account lockout protection
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  @@index([emailVerifiedAt, emailVerificationRequiredAt, emailVerificationDeletionStartedAt])
}

model WrappedKey {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // WebAuthn credential ID (base64url)
  credentialId String
  // AES-KW wrapped E2E key (base64url) - can only be unwrapped with PRF output
  wrappedKey   String
  // PRF salt used during credential creation (base64url)
  salt         String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthIDToken String? // prefixed with the ID of the issuing OAuth provider, separated by a colon
}

model LoginToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  used   Boolean @default(false)
}

model ResetPasswordToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  tokenHash String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  email     String

  // Deliberately not unique: a delayed relay can put several messages in the
  // inbox at once and every link issued must stay usable until it expires.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthUser {
  id               String @id @default(uuid())
  provider         String
  providerUserId   String
  providerUsername String
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TotpBackupCode {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  codeHash String
  usedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Share {
  id                     String    @id @default(uuid())
  // Opaque administration reference. The public Share.id is a capability URL
  // and must never be disclosed by the administration inventory.
  adminAuditId           String    @unique @default(uuid())
  createdAt              DateTime  @default(now())
  uploadLastActivityAt   DateTime?
  uploadCleanupStartedAt DateTime?

  name             String?
  uploadLocked     Boolean  @default(false)
  hasBeenCompleted Boolean  @default(false)
  isZipReady       Boolean  @default(false)
  views            Int      @default(0)
  expiration       DateTime
  description      String?
  removedReason    String?

  senderName  String?
  senderEmail String?

  notifyOnDownload        Boolean   @default(false)
  lastDownloadNotifSentAt DateTime?

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  reverseShareId String?
  reverseShare   ReverseShare? @relation(fields: [reverseShareId], references: [id], onDelete: Cascade)

  security           ShareSecurity?
  recipients         ShareRecipient[]
  files              File[]
  bridgeUploadTokens BridgeUploadToken[]
  downloadEvents     DownloadEvent[]
  storageProvider    String              @default("LOCAL")
  isE2EEncrypted     Boolean             @default(false)

  // E2EE access grants for this share.
  accessGrants AccessGrant[]

  // Optional: share linked to a team folder
  teamFolderId String?
  teamFolder   TeamFolder? @relation(fields: [teamFolderId], references: [id], onDelete: SetNull)

  // SHA-256 ownership proof for anonymous upload cancellation.
  anonymousSessionToken String?

  @@index([teamFolderId, uploadLocked, createdAt])
  @@index([creatorId, teamFolderId, uploadLocked])
  @@index([uploadLocked, hasBeenCompleted, uploadCleanupStartedAt, uploadLastActivityAt], map: "Share_unfinished_upload_cleanup_idx")
}

model ReverseShare {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name                  String?
  token                 String   @unique @default(uuid())
  shareExpiration       DateTime
  maxShareSize          String
  sendEmailNotification Boolean
  remainingUses         Int
  simplified            Boolean  @default(false)
  publicAccess          Boolean  @default(true)

  // E2E encryption: K_rs encrypted by the owner's master key (K_master).
  // Stored as base64url. The server never sees K_rs in clear text.
  encryptedReverseShareKey String?

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  shares Share[]
}

model ShareRecipient {
  id    String @id @default(uuid())
  email String

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@unique([shareId, email])
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name                String
  relativePath        String?
  size                String
  // Plaintext bytes per independently authenticated AES-GCM record.
  // Nullable keeps legacy E2E files compatible with chunk auto-detection.
  encryptionChunkSize Int?

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  accessRules        FileAccess[]
  // E2EE access grants for this file.
  accessGrants       AccessGrant[]
  signatureDocuments SignatureDocument[]

  @@index([shareId])
}

model BridgeUploadToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  tokenHash String    @unique
  label     String?
  usedAt    DateTime?
  revokedAt DateTime?

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@index([expiresAt])
}

model ShareSecurity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  password String?
  maxViews Int?

  shareId String? @unique
  share   Share?  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model Config {
  updatedAt DateTime @updatedAt

  name         String
  category     String
  type         String
  defaultValue String  @default("")
  value        String?
  obscured     Boolean @default(false)
  secret       Boolean @default(true)
  locked       Boolean @default(false)
  experimental Boolean @default(false)
  order        Int

  @@id([name, category])
}

model PushSubscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  endpoint String @unique
  p256dh   String
  auth     String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DownloadEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Whether the downloader was a registered user (anonymised: no identity stored)
  byRegisteredUser Boolean @default(false)

  // False until included in a digest/email notification
  notified Boolean @default(false)

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

// ============================================================================
// PDF ELECTRONIC SIGNATURE
// ============================================================================

// A document submitted for signing (linked to a Share's PDF file)
model SignatureDocument {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Original PDF file name
  fileName           String
  // Backward-compatible display title for existing deployments.
  title              String
  // Legacy storage key kept for databases created before originalFileKey.
  fileKey            String
  // Storage path/key for the original PDF
  originalFileKey    String
  // Storage path/key for the signed PDF (set after all signatures complete)
  signedFileKey      String?
  // Storage path/key for the certificate page PDF
  certificatePageKey String?

  // Document status: DRAFT | PENDING | COMPLETED | CANCELLED | EXPIRED
  status String @default("PENDING")

  // Optional message from the sender to all recipients
  message String?

  // Evidence level: STANDARD or REINFORCED
  signatureLevel String @default("STANDARD")

  // Expiration for signing (after which the request is void)
  expiresAt DateTime?

  // Completion timestamp
  completedAt DateTime?

  // Whether to add "Bon pour Accord" diagonal watermark field
  addApprovalField Boolean @default(true)

  // Whether to add "Lu et approuvé, le (date)" mention on each signature
  addApprovalMention Boolean @default(true)

  // Whether to add signers' initials at the bottom of every page
  addInitials Boolean @default(false)

  // Initials avoid the usual page-number zone and full-signature page by default.
  initialsPlacement            String  @default("BOTTOM_CENTER_RIGHT")
  initialsIncludeSignaturePage Boolean @default(false)

  // Page number (1-based) for signature placement (null = page 1)
  signaturePage Int?

  // Page number (1-based) for watermark placement (null = same as signaturePage)
  watermarkPage Int?

  // Whether the original PDF is E2E encrypted (client-side finalization required)
  isE2EEncrypted Boolean @default(false)

  // Creator / requester
  // Legacy owner alias kept for databases created before creatorId.
  ownerId   String
  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Keep a nullable source relation so deleting a file revokes every signing
  // action while retaining the request and its audit evidence for six months.
  shareId String?
  fileId  String?
  file    File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  recipients SignatureRecipient[]
  auditTrail SignatureAuditEvent[]
  fields     SignatureField[]

  // Team context (optional - for team-scoped documents)
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Set when the source file/share is detected as deleted.
  fileDeletedAt DateTime?

  @@index([teamId, createdAt])
  @@index([fileId])
  @@index([fileDeletedAt])
}

// A person required to sign a document
model SignatureRecipient {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recipient email (for notification and identity binding)
  email String
  // Recipient name (for the "Lu et approuvé" mention)
  name  String

  // Unique token for accessing the signing page (URL-safe)
  signingToken String @unique @default(uuid())

  // Recipient-encrypted Team actions. The server only stores opaque envelopes.
  teamInviteNotification     String?
  teamProgressNotification   String?
  teamCompletionNotification String?

  // Role: SIGNER | APPROVER | CC (carbon copy, view only)
  role String @default("SIGNER")

  // Signing order (1-based). Recipients with same order sign in parallel.
  order Int @default(1)

  // Status: PENDING | VIEWED | SIGNED | REJECTED | EXPIRED
  status String @default("PENDING")

  // Timestamp when the recipient signed
  signedAt DateTime?

  // Rejection reason (if status=REJECTED)
  rejectionReason String?

  // The actual signature data (base64 PNG of handwritten/image, or text)
  signatureData String?
  // Signature type: DRAW | TYPE | UPLOAD
  signatureType String?

  // Current mailbox-control verification for STANDARD requests.
  otpHash     String?
  otpSentAt   DateTime?
  otpVerified Boolean   @default(false)
  otpFailures Int       @default(0)

  // Account-level evidence for REINFORCED requests; this is not a civil eID.
  identityVerificationMethod String    @default("NONE")
  identityVerifiedAt         DateTime?

  authenticationMethod String?
  signingIntentHash    String?
  signedDocumentHash   String?
  webauthnCredentialId String?
  webauthnAssertion    String?
  webauthnUserVerified Boolean?
  webauthnDeviceType   String?
  webauthnBackedUp     Boolean?

  // IP address and user-agent at signing time (for audit)
  signingIp        String?
  signingUserAgent String?

  // Linked user (if the recipient is a registered user)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  documentId String
  document   SignatureDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fieldValues        SignatureFieldValue[]
  webauthnChallenges SigningWebAuthnChallenge[]
}

// Server-verified WebAuthn credential used only for reinforced signatures.
model SigningPasskey {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  credentialId String  @unique
  publicKey    Bytes
  counter      BigInt  @default(0)
  transports   String?
  deviceType   String
  backedUp     Boolean @default(false)
  aaguid       String?
  label        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time ceremony bound to a recipient and, for actions, to the exact intent.
model SigningWebAuthnChallenge {
  id                 String    @id @default(uuid())
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?
  purpose            String
  challenge          String    @unique
  intentHash         String?
  sourceDocumentHash String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   SignatureRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([recipientId, purpose, expiresAt])
}

// Configurable signature fields placed on the PDF
model SignatureField {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Field type: SIGNATURE | INITIALS | DATE | TEXT | APPROVAL
  type String @default("SIGNATURE")

  // Position on the PDF (page number, coordinates in points)
  page   Int
  posX   Float
  posY   Float
  width  Float
  height Float

  // Rotation in degrees (for diagonal "Bon pour Accord")
  rotation Float @default(0)

  // Placeholder/label text
  label String?

  // Whether this field is required
  required Boolean @default(true)

  documentId String
  document   SignatureDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Which recipient must fill this field (null = any)
  assignedRecipientId String?

  fieldValues SignatureFieldValue[]
}

// Actual value filled in a field by a recipient
model SignatureFieldValue {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // The value: base64 image for SIGNATURE/INITIALS, text for DATE/TEXT/APPROVAL
  value String

  fieldId String
  field   SignatureField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   SignatureRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([fieldId, recipientId])
}

// Immutable audit trail for eIDAS compliance
model SignatureAuditEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Event types: CREATED | SENT | VIEWED | SIGNED | REJECTED | CANCELLED |
  //              OTP_SENT | OTP_VERIFIED | DOWNLOADED | EXPIRED | REMINDER_SENT
  eventType String

  // Actor description (email, "system", or user ID)
  actor String

  // IP address of the actor
  ipAddress String?

  // User-Agent of the actor
  userAgent String?

  // Additional JSON metadata (e.g., field IDs signed, OTP method used)
  metadata String?

  // Application-level tamper-evident chain for newly appended events.
  previousEventHash String?
  eventHash         String? @unique

  documentId String
  document   SignatureDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// Server signing certificate configuration
model SigningCertificate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Human-readable name
  name String

  // PFX/P12 certificate (base64 encoded, encrypted at rest)
  certificateData String

  // Certificate password (encrypted at rest via app secret)
  encryptedPassword String

  // Certificate subject (CN, O, etc.)
  subject String?

  // Validity dates
  validFrom  DateTime?
  validUntil DateTime?

  // Whether this is the active/default certificate
  isDefault Boolean @default(false)

  // TSA (Time Stamp Authority) URL for long-term validation
  tsaUrl String?
}

// ============================================================================
// TEAM MANAGEMENT
// ============================================================================

model Team {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Team display name
  name String

  // URL-safe slug for the team
  slug String @unique

  // Team description
  description String?

  // Team avatar/logo (storage key)
  avatarKey String?

  // Whether the team feature is active (admin can disable)
  isActive Boolean @default(true)

  // Limits (0 = unlimited)
  maxMembers        Int    @default(0)
  maxShareSize      BigInt @default(0)
  totalStorageLimit BigInt @default(0)
  storageUsed       BigInt @default(0)

  // Owner
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members            TeamMember[]
  sharedFolders      TeamFolder[]
  accessLogs         TeamAccessLog[]
  invitations        TeamInvitation[]
  signatureDocuments SignatureDocument[]
  guestLinks         TeamGuestLink[]
  auditReports       TeamAuditReport[]
  keyRotations       TeamKeyRotation[]
  // Team notification feed.
  notifications      TeamNotification[]

  // Automatic compliance report policy.
  reportEnabled   Boolean @default(true)
  // Kept compatible with existing DAILY values; the UI offers WEEKLY | MONTHLY.
  reportFrequency String  @default("WEEKLY")

  // E2EE team-key rotation policy. The server only orchestrates ciphertext.
  keyVersion                Int       @default(1)
  keyRotatedAt              DateTime?
  keyRotationIntervalDays   Int       @default(90)
  keyRotationReminderDays   Int       @default(7)
  lastKeyRotationReminderAt DateTime?

  // Explicit opt-in for hybrid X25519 + ML-KEM-768 notification envelopes.
  pqNotificationEncryptionEnabled Boolean @default(false)
}

model TeamMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Role: OWNER | ADMIN | MEMBER
  role String @default("MEMBER")

  // Whether the member accepted the invitation
  isActive Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // E2E: K_team wrapped by this member's K_user (base64url).
  // The server never sees K_team in plaintext.
  wrappedTeamKey   String?
  teamKeyVersion   Int       @default(0)
  teamKeyUpdatedAt DateTime?

  // Per-member feature access (controlled by OWNER/ADMIN)
  canViewActivity   Boolean @default(false)
  canViewSignatures Boolean @default(false)

  // Push notification preference: EVERY_FILE | SHARES_ONLY
  pushNotifMode String @default("EVERY_FILE")

  // Folder access permissions
  folderAccess TeamFolderAccess[]
  fileAccess   FileAccess[]
  guestLinks   TeamGuestLink[]

  @@unique([userId, teamId])
}

model TeamFolder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Folder display name
  name String

  // Optional description
  description String?

  // Parent folder (for nested structure)
  parentId String?
  parent   TeamFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children TeamFolder[] @relation("FolderHierarchy")

  // Storage path/key prefix for files in this folder
  storagePrefix String

  // Color label (hex)
  color String?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  accessRules   TeamFolderAccess[]
  files         TeamFile[]
  accessLogs    TeamAccessLog[]
  guestLinks    TeamGuestLink[]
  shares        Share[]
  notifications TeamNotification[]

  @@index([teamId, parentId])
}

model TeamFolderAccess {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Permission level: READ | WRITE | ADMIN
  permission String @default("READ")

  // Per-member granular overrides (derived from permission level)
  canDownload         Boolean @default(true)
  canDelete           Boolean @default(true)
  canRequestSignature Boolean @default(false)
  canShareE2E         Boolean @default(false)

  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  folderId String
  folder   TeamFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([memberId, folderId])
}

model FileAccess {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Permission level: READ | WRITE | ADMIN
  permission          String  @default("READ")
  canRequestSignature Boolean @default(false)
  canShareE2E         Boolean @default(false)

  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([memberId, fileId])
}

model TeamFile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // File name
  name String

  // File size in bytes
  size BigInt

  // MIME type
  mimeType String?

  // Storage path/key
  storageKey String

  // Uploader
  uploadedById String?

  // Version tracking
  version Int @default(1)

  // Soft delete
  deletedAt DateTime?

  folderId String
  folder   TeamFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  accessLogs    TeamAccessLog[]
  // E2EE access grants for this team file.
  accessGrants  AccessGrant[]
  // Notifications related to this file.
  notifications TeamNotification[]
}

model TeamAccessLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Action: UPLOAD | DOWNLOAD | VIEW | DELETE | SHARE | SIGN
  action String

  // Actor info
  actorEmail String
  actorName  String?

  // IP and User-Agent
  ipAddress String?
  userAgent String?

  // Affected resource
  fileName   String?
  fileSize   BigInt?
  targetType String?
  targetId   String?
  // Structured JSON context. It must never contain E2EE key material.
  metadata   String?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  folderId String?
  folder   TeamFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  fileId String?
  file   TeamFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([teamId, action, createdAt])
}

// Immutable snapshot of an automatic or manually requested Team audit report.
model TeamAuditReport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  frequency   String
  periodStart DateTime
  periodEnd   DateTime
  status      String   @default("GENERATED") // GENERATED | SENT | FAILED

  // JSON summary only; no file contents or E2EE secrets.
  summary         String
  recipientEmails String
  sentAt          DateTime?
  error           String?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, frequency, periodStart, periodEnd])
  @@index([teamId, createdAt])
}

// A resumable client-side Team key rotation. Only wrapped key material is stored.
model TeamKeyRotation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromVersion Int
  toVersion   Int
  status      String @default("PREPARING") // PREPARING | REENCRYPTING | PAUSED | COMPLETED | CANCELLED
  reason      String @default("MANUAL") // MANUAL | POLICY

  startedById         String
  initiatorWrappedKey String
  totalFiles          Int       @default(0)
  processedFiles      Int       @default(0)
  failedFiles         Int       @default(0)
  // JSON array of File IDs already re-encrypted, used to resume safely.
  completedFileIds    String    @default("[]")
  errorMessage        String?
  completedAt         DateTime?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([teamId, createdAt])
}

model TeamInvitation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Invitee email
  email String

  // Invitation token (for the acceptance link)
  token String @unique @default(uuid())

  // Role to assign on acceptance
  role String @default("MEMBER")

  // Status: PENDING | ACCEPTED | EXPIRED | REVOKED
  status String @default("PENDING")

  // E2E: K_team encrypted for the invitee (base64url).
  // Derived from the invitation token; allows key transport during accept flow.
  encryptedTeamKey String?

  expiresAt DateTime

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([email, teamId])
}

model TeamGuestLink {
  id    String @id @default(uuid())
  token String @unique @default(uuid())

  label        String?
  permission   String  @default("READ") // READ | WRITE
  passwordHash String?

  maxDownloads  Int?
  downloadCount Int  @default(0)

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  folderId String
  folder   TeamFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   TeamMember @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([folderId])
}

// ============================================================================
// E2EE IDENTITY LAYER (X25519 + Ed25519 per-user key pairs)
// ============================================================================

// Each user has an asymmetric identity for key exchange and signing.
// Private keys are encrypted client-side before storage; the server never sees
// them in plaintext.
model UserIdentityKey {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Key type: X25519 | Ed25519
  keyType String

  // Public key shared for encryption or verification.
  publicKey String

  // Private key encrypted client-side with the user's master key.
  encryptedPrivateKey String

  // Algorithm identifier, for example x25519 or ed25519.
  algorithm String @default("x25519")

  // Active keys are used for newly created grants.
  isActive Boolean @default(true)

  // Key version, incremented on rotation.
  version Int @default(1)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyType, version])
  @@index([userId, keyType, isActive])
}

// ============================================================================
// ACCESS GRANTS - Encrypted DEK per user
// ============================================================================

// Each grant is an encrypted copy of a file key for one recipient.
// The server stores only ciphertext and cannot derive the plaintext key.
model AccessGrant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encryptedFileKey   String
  ephemeralPublicKey String
  nonce              String
  algorithm          String    @default("x25519-aes256gcm")
  dekVersion         Int       @default(1)
  status             String    @default("ACTIVE")
  revokedAt          DateTime?

  // User who created the grant.
  grantorId String

  // Recipient user.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  teamFileId String?
  teamFile   TeamFile? @relation(fields: [teamFileId], references: [id], onDelete: Cascade)

  shareId String?
  share   Share?  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, status, createdAt])
  @@index([grantorId, status, createdAt])
  @@index([fileId, status])
  @@index([teamFileId, status])
  @@index([shareId, status])
  @@index([userId, fileId, dekVersion])
}

// ============================================================================
// ENROLLMENT TOKEN - One-time bootstrap for onboarding or device addition
// ============================================================================

model EnrollmentToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  token     String    @unique
  purpose   String
  metadata  String?
  status    String    @default("PENDING")
  usedAt    DateTime?
  usedById  String?
  expiresAt DateTime
  creatorId String
  teamId    String?

  @@index([token])
  @@index([teamId, status])
}

// ============================================================================
// TEAM FILE NOTIFICATIONS
// ============================================================================

model TeamNotification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  type              String
  title             String
  metadata          String?
  encryptedMetadata String?
  isRead            Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  teamFileId String?
  teamFile   TeamFile? @relation(fields: [teamFileId], references: [id], onDelete: SetNull)

  folderId String?
  folder   TeamFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  actorId String?

  @@index([userId, isRead])
  @@index([teamId, createdAt])
  @@index([userId, teamId])
}

// ============================================================================
// POST-QUANTUM KEY ENCAPSULATION PREPARATION
// ============================================================================

model UserPQKey {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  variant             String  @default("ML-KEM-768")
  publicKey           String
  encryptedPrivateKey String
  version             Int     @default(1)
  isActive            Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId, isActive])
}
