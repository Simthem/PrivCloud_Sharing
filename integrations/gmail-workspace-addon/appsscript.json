{
  "timeZone": "Europe/Paris",
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.action.compose"
  ],
  "addOns": {
    "common": {
      "name": "PrivCloud",
      "logoUrl": "https://share.example.com/install/assets/privcloud-gmail-logo-v1.png",
      "openLinkUrlPrefixes": [
        "https://share.example.com/"
      ],
      "homepageTrigger": {
        "runFunction": "homepage"
      }
    },
    "gmail": {
      "composeTrigger": {
        "selectActions": [
          {
            "text": "Envoyer avec PrivCloud",
            "runFunction": "composeAction"
          }
        ],
        "draftAccess": "NONE"
      }
    }
  }
}
